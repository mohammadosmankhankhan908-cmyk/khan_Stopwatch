{ 
  "disk:linux": "vite build && electron-builder --linux tar.gz",
  "name": "khan_stopwatch",
  "productName": "khan_Stopwatch",
  "description": "Premium circular stopwatch and countdown timer",
  "author": {"name": "Khan Sahib" , "email": "mohammadosmankhankhan908@gmail.com"},
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "app": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:linux": "vite build && electron-builder --linux tar.gz",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:all": "vite build && electron-builder --win --linux tar.gz --mac"
  },

  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.0"
  },
  "build": {
    "appId": "com.khan.stopwatch",
    "productName": "khan_Stopwatch",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "main.cjs"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "linux": {
      "target": ["tar.gz" ],
      "category": "Utility",
      "executableName": "khan-Stopwatch"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    }
  }
}